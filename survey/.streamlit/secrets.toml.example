# Streamlit Secrets Configuration
# 
# For local development: Save as .streamlit/secrets.toml
# For Streamlit Cloud: Add via dashboard settings
#
# NEVER commit this file with real credentials!

# MongoDB Connection
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI = "mongodb+srv://username:password@cluster.mongodb.net/dp_survey?retryWrites=true&w=majority"

# Alternative: Local MongoDB
# MONGODB_URI = "mongodb://localhost:27017/"

# Admin Credentials
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "your-secure-password-here"

PROLIFIC_PASSED = "https://app.prolific.com/submissions/complete?cc=XXXXX"
PROLIFIC_PASSED_CODE = "XXXXX"
PROLIFIC_FAILED = "https://app.prolific.com/submissions/complete?cc=YYYYY"
PROLIFIC_FAILED_CODE = "YYYYY"
